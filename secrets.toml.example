# Copy this to .streamlit/secrets.toml for LOCAL testing only.
# On Streamlit Community Cloud, paste the same keys/values into
# App settings -> Secrets instead -- do not commit a real secrets.toml.

GITHUB_TOKEN = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GITHUB_REPO = "your-github-username/your-repo-name"
GITHUB_FILE_PATH = "data/master.xlsx"
GITHUB_BRANCH = "main"
